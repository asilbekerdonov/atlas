{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">{{ 'home.title'|trans }}</h1>

    {# Cards — все цифры одного цвета, без border-left #}
    <div class="row g-3 mb-4 text-center">
        <div class="col">
            <div class="card card-stats shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-number">{{ stats.cvs_last_24h }}</div>
                    <div class="stat-label">{{ 'home.stats.cvs_24h'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card card-stats shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-number">{{ stats.positions }}</div>
                    <div class="stat-label">{{ 'home.stats.positions'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card card-stats shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-number">{{ stats.candidates }}</div>
                    <div class="stat-label">{{ 'home.stats.candidates'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card card-stats shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-number">{{ stats.recruiters }}</div>
                    <div class="stat-label">{{ 'home.stats.recruiters'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card card-stats shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-number">{{ stats.cvs }}</div>
                    <div class="stat-label">{{ 'home.stats.cvs'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Latest positions #}
    <h2 class="section-title mt-4">
        <i class="bi bi-clock-history"></i> {{ 'home.latest'|trans }}
    </h2>
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle bg-body home-table">
            <thead class="table-light">
                <tr>
                    <th><i class="bi bi-briefcase"></i> {{ 'table.position'|trans }}</th>
                    <th><i class="bi bi-building"></i> {{ 'table.company'|trans }}</th>
                    <th><i class="bi bi-tags"></i> {{ 'table.tags'|trans }}</th>
                    <th><i class="bi bi-layout-text-window"></i> {{ 'table.format'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for position in latestPositions %}
                    <tr>
                        <td><a class="position-title" href="{{ path('position_show', {id: position.id}) }}">{{ position.title }}</a></td>
                        <td>{{ position.companyName ?? '—' }}</td>
                        <td>
                            {% for tag in position.tags %}
                                <span class="badge tag-badge">{{ tag.name }}</span>
                            {% endfor %}
                        </td>
                          {% if position.format %}<td><span class="badge bg-secondary-subtle text-secondary border me-1"><i class="bi bi-geo-alt"></i> {{ position.format.label }}</span></td>  {% endif %}
                    </tr>
                {% else %}
                    <td colspan="4" class="text-center text-muted py-4">'—'</td>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Most popular positions #}
    <h2 class="section-title mt-4">
        <i class="bi bi-trophy"></i> {{ 'home.most_popular'|trans }}
    </h2>
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle bg-body home-table">
            <thead class="table-light">
                <tr>
                    <th><i class="bi bi-trophy"></i> {{ 'table.position'|trans }}</th>
                    <th><i class="bi bi-file-earmark-text"></i> {{ 'table.status'|trans }}</th>
                    <th><i class="bi bi-heart"></i> {{ 'table.likes'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for position in topPositions %}
                    <tr>
                        <td><a class="position-title" href="{{ path('position_show', {id: position.id}) }}">{{ position.title }}</a></td>
                        <td>
                            {% set cvCount = position.cvs|length %}
                            {% if cvCount > 5 %}
                                <span class="status-badge status-high">
                                    <i class="bi bi-file-earmark-text"></i> {{ cvCount }} CV
                                </span>
                            {% elseif cvCount > 0 %}
                                <span class="status-badge status-medium">
                                    <i class="bi bi-file-earmark-text"></i> {{ cvCount }} CV
                                </span>
                            {% else %}
                                <span class="status-badge status-low">
                                    <i class="bi bi-file-earmark-text"></i> {{ cvCount }} CV
                                </span>
                            {% endif %}
                        </td>
                        <td class="likes-cell">
                            <i class="bi bi-heart-fill"></i>
                            {{ position.cvs|reduce((carry, cv) => carry + cv.likesCount, 0) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="text-center text-muted py-4">{{ 'table.empty'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Tag cloud #}
    <h2 class="section-title mt-4">
        <i class="bi bi-cloud"></i> {{ 'home.tag_cloud'|trans }}
    </h2>
    <div class="tag-cloud mb-4">
        {% for tag in tagCloud %}
            {% set size = 0.85 + (tag.count / 25) %}
            {% if size > 1.35 %}{% set size = 1.35 %}{% endif %}
            <a href="{{ path('search_index') }}?q={{ tag.name|url_encode }}"
               class="tag-pill" style="font-size: {{ size }}rem">
                {{ tag.name }} ({{ tag.count }})
            </a>
        {% else %}
            <span class="text-muted">—</span>
        {% endfor %}
    </div>
{% endblock %}