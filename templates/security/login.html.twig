{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.login'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-5 col-lg-4">
            <div class="card bg-body-tertiary border shadow-sm rounded-4 p-4">
                <h1 class="h4 text-center fw-bold mb-4">{{ 'nav.login'|trans }}</h1>

                {% if error %}
                    <div class="alert alert-danger py-2">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input class="form-control bg-body text-body border-secondary-subtle" type="email"
                               name="_username" value="{{ last_username }}" required autofocus placeholder="you@example.com">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Password</label>
                        <input class="form-control bg-body text-body border-secondary-subtle" type="password"
                               name="_password" required placeholder="••••••••">
                    </div>
                    <button class="btn btn-primary w-100 fw-semibold" type="submit">{{ 'nav.login'|trans }}</button>
                </form>

                <p class="text-center text-muted small mb-0 mt-3">
                    {{ 'login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'login.register'|trans }}</a>
                </p>

                <div class="text-center text-muted small my-3">— or —</div>

                <div class="d-grid gap-2">
                    <a class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2"
                       href="{{ path('connect_google_start') }}">
                        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        <span class="fw-semibold">Continue with Google</span>
                    </a>
                    <a class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2"
                       href="{{ path('connect_github_start') }}">
                        <i class="bi bi-github fs-5"></i>
                        <span class="fw-semibold">Continue with GitHub</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
