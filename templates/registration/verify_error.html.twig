{% extends 'base.html.twig' %}

{% block title %}Verification problem{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-5 col-lg-4">
            <div class="card bg-body-tertiary border shadow-sm rounded-4 p-4">
                <h1 class="h4 text-center fw-bold mb-3">
                    {% if reason == 'expired' %}Link expired{% else %}Invalid link{% endif %}
                </h1>
                <p class="text-muted small text-center mb-3">
                    {% if reason == 'expired' %}
                        This confirmation link has expired (it is valid for 1 hour).
                        Request a new one below.
                    {% else %}
                        This confirmation link is invalid. It may have already been
                        used — request a new one below if your account is still pending.
                    {% endif %}
                </p>
                <form method="post" action="{{ path('app_register_resend') }}">
                    <input type="hidden" name="email" value="{{ email }}">
                    <button class="btn btn-primary w-100 fw-semibold" type="submit">Resend confirmation email</button>
                </form>
                <p class="text-center mt-3 mb-0">
                    <a href="{{ path('app_login') }}" class="small">Back to login</a>
                </p>
            </div>
        </div>
    </div>
{% endblock %}
