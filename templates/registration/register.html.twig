{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-5 col-lg-4">
            <div class="card bg-body-tertiary border shadow-sm rounded-4 p-4">
                <h1 class="h4 text-center fw-bold mb-4">Create account</h1>

                {% for error in errors %}
                    <div class="alert alert-danger py-2">{{ error }}</div>
                {% endfor %}

                <form method="post" action="{{ path('app_register') }}">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input class="form-control bg-body text-body border-secondary-subtle" type="email"
                               name="email" value="{{ email }}" required autofocus placeholder="you@example.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <input class="form-control bg-body text-body border-secondary-subtle" type="password"
                               name="password" required minlength="8" placeholder="••••••••">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Confirm password</label>
                        <input class="form-control bg-body text-body border-secondary-subtle" type="password"
                               name="confirmPassword" required placeholder="••••••••">
                    </div>
                    <button class="btn btn-primary w-100 fw-semibold" type="submit">Register</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
