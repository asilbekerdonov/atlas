<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%232F5D50'/><text x='32' y='44' font-family='Georgia,serif' font-size='38' font-weight='700' fill='%23F7F6F3' text-anchor='middle'>A</text></svg>">
    <title>{% block title %}ATLAS{% endblock %}</title>

    {# Theme applied before render to avoid a flash of the wrong theme. #}
    <script>
        (function () {
            var stored = localStorage.getItem('cv-theme');
            var theme = stored || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/@yaireo/tagify@4.20.0/dist/tagify.css" rel="stylesheet">
    {# Theme overrides MUST come after the Bootstrap CDN stylesheet so the
       --bs-* variable redefinitions win. #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-body-tertiary">
<nav class="navbar navbar-expand-lg fixed-top bg-dark navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
            <i class="bi bi-file-earmark-person-fill"></i>ATLAS
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('position_index') }}">
                        {{ 'nav.positions'|trans }}
                        {% if is_granted('ROLE_RECRUITER') and newCvsBadge.newCvsCount() > 0 %}
                            <span class="badge bg-danger rounded-pill">{{ newCvsBadge.newCvsCount() }} new</span>
                        {% endif %}
                    </a>
                </li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">{{ 'nav.stats'|trans }}</a></li>
                {# "My profile" only for REAL candidates: role_hierarchy grants
                   ROLE_CANDIDATE to admins, so is_granted() would show the item
                   to an admin who has no candidate profile (403 on click). #}
                {% if app.user and 'ROLE_CANDIDATE' in app.user.roles %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('profile_show_own') }}">{{ 'nav.profile'|trans }}</a></li>
                {% endif %}
                {% if is_granted('ROLE_RECRUITER') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('attribute_index') }}">{{ 'nav.attributes'|trans }}</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('position_new') }}">{{ 'nav.new_position'|trans }}</a></li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('admin_users') }}">{{ 'nav.users'|trans }}</a></li>
                {% endif %}
                
            </ul>

            <form class="d-flex me-2 position-relative" role="search" action="{{ path('search_index') }}" method="get" id="nav-search-form">
                <input class="form-control form-control-sm me-1" type="search" name="q" id="nav-search"
                       value="{{ q is defined ? q : '' }}" placeholder="{{ 'nav.search_placeholder'|trans }}"
                       aria-label="Search" autocomplete="off">
                <button class="btn btn-outline-light btn-sm" type="submit"><i class="bi bi-search"></i></button>
                <div class="dropdown-menu show shadow d-none position-absolute top-100 start-0" id="nav-search-suggest" style="width:100%"></div>
            </form>

            <div class="d-flex align-items-center gap-2">
                <div class="btn-group btn-group-sm">
                    <a href="{{ path('app_locale', {locale: 'en'}) }}"
                       class="btn {{ app.request.locale == 'en' ? 'btn-primary' : 'btn-outline-light' }}">EN</a>
                    <a href="{{ path('app_locale', {locale: 'ru'}) }}"
                       class="btn {{ app.request.locale == 'ru' ? 'btn-primary' : 'btn-outline-light' }}">RU</a>
                </div>
                <button type="button" class="btn btn-sm btn-outline-light" id="theme-toggle"
                        title="{{ 'nav.theme.dark'|trans }}" aria-label="Toggle theme">
                    <i class="bi bi-moon-stars"></i>
                </button>

                {% if app.user %}
                    <span class="navbar-text text-light small">{{ app.user.email }}</span>
                    <form method="post" action="{{ path('app_logout') }}" class="m-0">
                        <button class="btn btn-sm btn-outline-danger" type="submit">{{ 'nav.logout'|trans }}</button>
                    </form>
                {% else %}
                    <a class="btn btn-sm btn-primary" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<main class="container py-4" style="padding-top: 0.5rem !important;">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toast-container"></div>
<footer class="border-top py-4 mt-5 text-center text-secondary small">
        &copy; {{ 'footer.copyright'|trans({'%year%': "now"|date("Y")}) }}
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@yaireo/tagify@4.20.0/dist/tagify.min.js"></script>
<script src="{{ asset('js/theme-switcher.js') }}"></script>
<script src="{{ asset('js/action-toolbar.js') }}"></script>
<script>
    // Live autocomplete under the header search box.
    (function () {
        'use strict';
        const input = document.getElementById('nav-search');
        const suggest = document.getElementById('nav-search-suggest');
        if (!input || !suggest) { return; }

        let timer = null;
        input.addEventListener('input', function () {
            clearTimeout(timer);
            const q = input.value.trim();
            if (q.length < 2) {
                suggest.classList.add('d-none');
                suggest.innerHTML = '';
                return;
            }
            timer = setTimeout(function () {
                fetch('/api/search/suggest?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        suggest.innerHTML = '';
                        if (!items.length) {
                            suggest.classList.add('d-none');
                            return;
                        }
                        items.forEach(function (item) {
                            const a = document.createElement('a');
                            a.className = 'dropdown-item';
                            a.href = '/positions/' + item.id;
                            a.innerHTML = '<strong></strong><small class="text-muted float-end"></small>';
                            a.querySelector('strong').textContent = item.title;
                            a.querySelector('small').textContent = item.company || '';
                            suggest.appendChild(a);
                        });
                        suggest.classList.remove('d-none');
                    }).catch(function () { suggest.classList.add('d-none'); });
            }, 250);
        });
        document.addEventListener('click', function (e) {
            if (!e.target.closest('#nav-search-form')) {
                suggest.classList.add('d-none');
            }
        });
    })();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
