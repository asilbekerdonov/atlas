{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
    <h1 class="h4">{{ 'admin.title'|trans }}</h1>

    <div data-action-toolbar>
        <div class="btn-toolbar mb-2 gap-2">
            <button type="button" class="btn btn-outline-success btn-sm" data-action="promote" data-url-prefix="/admin/users/" data-required-role="ROLE_CANDIDATE" data-confirm="{{ 'admin.confirm_promote'|trans }}" disabled>
                <i class="bi bi-arrow-up"></i> {{ 'admin.promote'|trans }}
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="demote" data-url-prefix="/admin/users/" data-required-role="ROLE_RECRUITER" data-confirm="{{ 'admin.confirm_demote'|trans }}" disabled>
                <i class="bi bi-arrow-down"></i> {{ 'admin.demote'|trans }}
            </button>
            <button type="button" class="btn btn-outline-warning btn-sm" data-action="block" data-url-prefix="/admin/users/" disabled>
                <i class="bi bi-person-slash"></i> {{ 'admin.block_unblock'|trans }}
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle bg-body">
                <thead class="table-light">
                <tr><th style="width:2.5rem"></th><th>{{ 'admin.email'|trans }}</th><th>{{ 'admin.roles'|trans }}</th><th>{{ 'admin.blocked'|trans }}</th><th>{{ 'admin.created'|trans }}</th></tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr data-row-id="{{ user.id }}" data-role="{{ user.primaryRole.value }}">
                        <td><input type="checkbox" class="form-check-input" aria-label="Select"></td>
                        <td>{{ user.email }}</td>
                        <td>{% for role in user.roles %}<span class="badge text-bg-secondary">{{ role }}</span> {% endfor %}</td>
                        <td>{% if user.isBlocked %}<span class="badge text-bg-danger">{{ 'admin.blocked_badge'|trans }}</span>{% else %}<span class="badge text-bg-success">{{ 'admin.active'|trans }}</span>{% endif %}</td>
                        <td>{{ user.createdAt|date('Y-m-d') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
