# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# .env.local is NOT loaded when APP_ENV=test, so the DB connection must be
# declared here. The "_test" dbname_suffix (doctrine.yaml) makes it cv_platform_test.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/cv_platform?serverVersion=16&charset=utf8"
# Deliver mail synchronously in tests so MailerAssertionsTrait can observe it.
MESSENGER_TRANSPORT_DSN=sync://

# Test-only placeholders (not real keys; the profile page render asserts the
# data attribute is present and non-empty in the test environment too).
YANDEX_MAPS_JS_API_KEY=test-js-api-key
YANDEX_GEOCODER_API_KEY=test-geocoder-key
